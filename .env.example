# Copiar a .env y rellenar. El .env NO se sube al repo (ver .dockerignore).

# Obligatorio: secreto para firmar cookies de sesion (32+ bytes aleatorios)
SECRET_KEY=

# Email real (Gmail / cuenta IRB). Sin SMTP_HOST, los magic links se imprimen por consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Hora de cierre diario de elecciones (0-23, hora local del contenedor, TZ=Europe/Madrid)
BOOKING_LOCK_HOUR=8
